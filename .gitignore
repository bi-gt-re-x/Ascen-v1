# Python
__pycache__/
*.pyc
.pytest_cache/
.venv/
.venv-fastapi/

# Node
node_modules/
frontend/dist/

# Written by `npm run test:coverage`. A report of the tests, not a test.
coverage/

# Environment files. One .env at the root serves both halves — vite.config.ts
# points envDir back here so the frontend reads the same file the backend does.
.env

# Local tool settings
.claude/settings.local.json

# The live database, rebuilt from data/sql/ when absent
data/ascen.db

# Snapshots taken before a bulk write (scripts/seed_year.py). Local
# safety copies of the live database, not history worth carrying.
data/backups/*.db*
data/ascen.db-wal
data/ascen.db-shm

# Database snapshots taken before a seeding or migration run. Local safety
# copies of an already-ignored file; the .json exports beside them are the
# tracked fixtures.
data/backups/*.db

# A development session key, generated on first run when SECRET_KEY is unset.
# Per-machine and never shared — see backend/config/settings.py.
data/.session_key
