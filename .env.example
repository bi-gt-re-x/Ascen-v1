# Copy this file to `.env` (same folder) and fill in what you want to switch on.
# `.env` is read at startup by run.py and is git-ignored — never commit real keys.
# Everything here is optional: with none of it set the app still runs, verification
# links print to the server console, and the Google button stays hidden.

# --- Session signing -------------------------------------------------------
# Any long random string. Changing it signs everyone out.
SECRET_KEY=change-me-to-something-random

# --- Sending verification e-mail ------------------------------------------
# Gmail: turn on 2-Step Verification, then create an App Password
# (Google Account -> Security -> 2-Step Verification -> App passwords).
# It is 16 characters; paste it with or without spaces.
# Recipients can be on any provider — Gmail, Outlook, anything.
MAIL_USERNAME=you@gmail.com
MAIL_PASSWORD=your-16-char-app-password
MAIL_FROM=Ascen <you@gmail.com>
# Defaults suit Gmail; Outlook/Office 365 is smtp.office365.com on port 587.
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587

# --- Sign in with Google ---------------------------------------------------
# console.cloud.google.com -> APIs & Services -> Credentials
#   -> Create credentials -> OAuth client ID -> Web application
#   -> Authorised redirect URI: http://127.0.0.1:5050/auth/google/callback
# Copy the client ID and secret it shows you into these two lines.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Links in outgoing e-mail ---------------------------------------------
# The origin verification links point at. Set this when the port isn't 5050 or
# once the app is reachable somewhere other than this laptop.
APP_BASE_URL=http://127.0.0.1:5050
